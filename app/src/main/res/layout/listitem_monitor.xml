<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/margin_small"
        android:gravity="center_vertical">

        <!-- ID column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="3">

            <TextView
                android:id="@+id/listitem_monitor_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="monospace"
                android:textSize="@dimen/can_id_textsize" />

            <!-- Flags row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/listitem_monitor_rtr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="RTR" />

                <TextView
                    android:id="@+id/listitem_monitor_extended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29"
                    android:textSize="10sp"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone"
                    tools:text="29" />

            </LinearLayout>

        </LinearLayout>

        <!-- Data column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_medium">

            <!-- DLC + RTR -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/listitem_monitor_dlc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingStart="@dimen/padding_byte"
                    android:paddingEnd="@dimen/padding_byte"
                    tools:text="8" />

                <TextView
                    android:id="@+id/listitem_monitor_rtr_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/can_rtr"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Data bytes -->
            <LinearLayout
                android:id="@+id/listitem_monitor_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView android:id="@+id/listitem_monitor_data0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/listitem_monitor_data7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/can_data_byte_textsize" android:fontFamily="monospace" android:paddingStart="@dimen/padding_byte" android:paddingEnd="@dimen/padding_byte" android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/listitem_monitor_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="999ms" />

                <TextView
                    android:id="@+id/listitem_monitor_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="@dimen/margin_medium"
                    tools:text="999" />

                <TextView
                    android:id="@+id/listitem_monitor_fc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:visibility="gone"
                    tools:text="FC: 5" />

            </LinearLayout>

        </LinearLayout>

        <!-- Comment indicator -->
        <ImageView
            android:id="@+id/listitem_monitor_comment_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_info"
            android:visibility="gone"
            android:layout_marginStart="@dimen/margin_small"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
