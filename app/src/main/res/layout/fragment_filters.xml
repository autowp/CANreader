<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_medium"
    android:paddingTop="@dimen/margin_small"
    android:paddingEnd="@dimen/margin_medium"
    tools:context="com.autowp.canreader.FiltersFragment">

    <!-- TabLayout for filter types -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/filterTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_hw" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_sw" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_gateway" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Hardware Filter tab content -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHwFilter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Add filter button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAddHwFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="@dimen/margin_small"
                android:text="@string/filter_add"
                style="@style/Widget.Material3.Button.TonalButton"
                android:icon="@android:drawable/ic_menu_add" />

            <!-- Hardware filter list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHwFilters"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/margin_small" />

            <TextView
                android:id="@+id/tvEmptyHwFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="No hardware filters configured"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Software Filter tab content (hidden by default) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSwFilter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAddSwFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="@dimen/margin_small"
                android:text="@string/filter_add"
                style="@style/Widget.Material3.Button.TonalButton"
                android:icon="@android:drawable/ic_menu_add" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSwFilters"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/margin_small" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Gateway tab content (hidden by default) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGateway"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gateway_from_channel"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gateway_to_channel"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginTop="@dimen/margin_small" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGateway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_enabled"
                android:layout_marginTop="@dimen/margin_medium" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
